@startuml Sequence
participant "Button (onClick)" as btn
participant useMutation as hook
participant MutationObserver as observer
participant MutationCache as cache
participant Mutation as mut
participant Retryer as retryer
participant mutationFn as fn
participant React as React

btn -> hook: mutate(vars)
hook -> observer: mutate(vars, options)
observer -> cache: build(client, options)
cache -> mut: new Mutation(...)
cache -> mut: add(mutation)
observer -> mut: addObserver(this)
observer -> mut: execute(vars)
mut -> retryer: createRetryer(config)
mut -> mut: #dispatch(pending)
mut --> observer: onMutationUpdate(action)
observer -> observer: #updateResult()
observer -> observer: #notify(action)
mut -> retryer: start()
retryer -> fn: fn()
fn --> retryer: data
retryer --> mut: resolve
mut -> mut: #dispatch(success)
mut --> observer: onMutationUpdate(action)
observer -> observer: #updateResult()
observer -> observer: #notify(action)
observer --> hook: listener(result)
hook -> React: Перерисовать компонент

note over observer, hook
    Слушатели вызываются после каждого #notify: как для
    статуса Pending, так и для Success
end note
@enduml